# This file is read by Git for line-ending and diff behavior.
# Windows is the primary platform, so text files use CRLF on checkout.

* text=auto

# Keep the Rust source and docs as text so git normalizes them.
*.rs text
*.md text
*.toml text
*.json text
*.html text
*.js text
*.css text
*.bat text

# Binary assets: never touch the bytes.
*.ico binary
*.png binary
*.lock binary
